# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3005
APP_LANG=vi
TZ=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=2mb
RATE_LIMIT_MAX=1000

# PostgreSQL/PostGIS (native VPS service)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=campha
DB_USER=campha_app
DB_PASSWORD=change-me
DB_POOL_MIN=2
DB_POOL_MAX=25
DB_CONN_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_SLOW_QUERY_MS=500

# JWT/Auth
JWT_SECRET=change-me-at-least-32-characters
JWT_SECRET_REFRESH=change-me-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Chưa sử dụng MFA; chỉ đổi true sau khi UAT client hoàn tất.
MFA_ENABLED=false
# 32 bytes hex; chỉ cần khi MFA_ENABLED=true. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=change-me-64-hex-characters
# LDAP đã tích hợp; giữ false đến khi LDAPS/CA/network/live UAT đạt rollout gate.
LDAP_ENABLED=false
# Chỉ bật sau khi LDAPS/CA/network/UAT thật đạt. Không dùng ldap:// hoặc tắt certificate verification.
LDAP_URL=ldaps://dc01.example.local:636
LDAP_BASE_DN=DC=example,DC=local
LDAP_BIND_DN=svc_campha_ldap@example.local
LDAP_BIND_PASSWORD_FILE=/etc/campha/secrets/ldap-bind-password
LDAP_CA_FILE=/etc/campha/certs/ad-ca.pem
LDAP_LOGIN_ATTRIBUTE=sAMAccountName
LDAP_ID_ATTRIBUTE=objectGUID
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_NAME_ATTRIBUTE=displayName
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_OPERATION_TIMEOUT_MS=5000
LDAP_AUTH_RATE_LIMIT=10
LDAP_MAX_LOGIN_ATTEMPTS=3
REQUIRE_EMAIL_VERIFICATION=true
AUTH_RATE_LIMIT=20
RESET_RATE_LIMIT=5

# Background Layer jobs: PostgreSQL durable queue, không Redis; mặc định concurrency=1.
# Chỉ bật sau khi STORAGE_ENABLED=true, migration 007 và GDAL/PROJ self-check đạt.
LAYER_WORKER_ENABLED=false
LAYER_WORKER_CONCURRENCY=1
LAYER_WORKER_POLL_MS=1500
LAYER_WORKER_LEASE_SECONDS=120
LAYER_WORK_DIR=/var/lib/campha/layer-worker
LAYER_GDAL_TIMEOUT_MS=600000
LAYER_DB_TIMEOUT_MS=300000
LAYER_IMPORT_ERROR_LIMIT=1000
GDAL_OGR2OGR_PATH=/usr/bin/ogr2ogr
GDAL_OGRINFO_PATH=/usr/bin/ogrinfo
PROJ_DATA_PATH=/usr/share/proj
GDAL_DATA_PATH=/usr/share/gdal
LAYER_ZIP_MAX_ENTRIES=64
LAYER_ZIP_MAX_ENTRY_MB=512
LAYER_ZIP_MAX_EXPANDED_MB=1024
LAYER_ZIP_MAX_COMPRESSION_RATIO=100

# MinIO (native VPS service; private buckets only)
STORAGE_ENABLED=false
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY_FILE=/etc/campha/secrets/minio-access-key
MINIO_SECRET_KEY_FILE=/etc/campha/secrets/minio-secret-key
MINIO_BUCKET_LAYERS=campha-layers
MINIO_BUCKET_RASTER=campha-raster
MINIO_BUCKET_DOCUMENTS=campha-documents
MINIO_BUCKET_FIELD_PHOTOS=campha-field-photos
MINIO_BUCKET_QUARANTINE=campha-quarantine
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRE_SECONDS=900
MINIO_UPLOAD_PRESIGNED_EXPIRE_SECONDS=900
STORAGE_MAX_LAYER_MB=500
STORAGE_MAX_RASTER_MB=2048
STORAGE_MAX_DOCUMENT_MB=50
STORAGE_MAX_FIELD_PHOTO_MB=10

# ClamAV native service. Commit upload fail-closed nếu scanner lỗi/mất kết nối.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# GeoServer (native VPS service; bind private/local interface)
GEOSERVER_ENABLED=false
GEOSERVER_URL=http://127.0.0.1:8080/geoserver
GEOSERVER_USER=campha_service
GEOSERVER_PASSWORD_FILE=/etc/campha/secrets/geoserver-password
GEOSERVER_WORKSPACE=campha
GEOSERVER_NAMESPACE_URI=https://gis.campha.gov.vn/campha
GEOSERVER_DATASTORE=campha_postgis
GEOSERVER_TIMEOUT_MS=15000
MAP_PROXY_MAX_RESPONSE_MB=25

# Google/Firebase/SMTP: cấu hình riêng khi triển khai module tương ứng
