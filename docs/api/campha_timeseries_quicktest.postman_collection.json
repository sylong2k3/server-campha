{
  "info": {
    "_postman_id": "c7f99999-bbbb-4aaa-9999-123456789abc",
    "name": "Cẩm Phả - Test Nhanh GeoTIFF Time Series",
    "description": "Bộ sưu tập test nhanh dành riêng cho tính năng GeoTIFF Time Series trên hệ thống Cẩm Phả HydroMap",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://apicampha.tourismpj.pro.vn",
      "type": "string"
    },
    {
      "key": "tnmtEmail",
      "value": "tnmt@campha.gov.vn",
      "type": "string"
    },
    {
      "key": "tnmtPassword",
      "value": "CamPha@2026",
      "type": "string"
    },
    {
      "key": "tnmtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "coverageKey",
      "value": "test4",
      "type": "string"
    },
    {
      "key": "timeSeriesLayerId",
      "value": "269",
      "type": "string"
    },
    {
      "key": "timeSeriesSelectedTime",
      "value": "2026-09-06T00:00:00.000Z",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Đăng nhập Sở TN&MT (Lấy Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{tnmtEmail}}\",\n  \"password\": \"{{tnmtPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Đăng nhập tài khoản Sở TN&MT để tự động lưu accessToken vào biến {{tnmtToken}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Đăng nhập thành công 200 OK', () => pm.response.to.have.status(200));",
              "const token = pm.response.json().data?.accessToken;",
              "if (token) {",
              "    pm.collectionVariables.set('tnmtToken', token);",
              "    console.log('Đã lưu token thành công!');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Lấy danh sách lớp Time Series (Catalog)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/web-map/time-series-layers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "web-map",
            "time-series-layers"
          ]
        },
        "description": "Lấy danh sách toàn bộ các ImageMosaic collection có thanh slider thời gian."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Lấy catalog thành công 200 OK', () => pm.response.to.have.status(200));",
              "const list = pm.response.json().data || [];",
              "pm.test('Có ít nhất 1 layer Time Series', () => pm.expect(list.length).to.be.at.least(1));",
              "if (list.length > 0) {",
              "    const target = list.find(l => l.code === 'test4_ts') || list[0];",
              "    pm.collectionVariables.set('timeSeriesLayerId', String(target.id));",
              "    if (target.timeSeries?.defaultTime) {",
              "        pm.collectionVariables.set('timeSeriesSelectedTime', target.timeSeries.defaultTime);",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Xuất bản chuỗi thời gian (Publish Collection)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tnmtToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"test4_ts\",\n  \"nameVi\": \"Chuỗi ảnh vệ tinh thử nghiệm test4\",\n  \"category\": \"test\",\n  \"srid\": 4326,\n  \"minZoom\": 0,\n  \"maxZoom\": 22,\n  \"legendConfig\": {},\n  \"metadata\": {\n    \"source\": \"admin_geotiff_upload\"\n  },\n  \"isPublic\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/remote-sensing/collections/{{coverageKey}}/publish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "remote-sensing",
            "collections",
            "{{coverageKey}}",
            "publish"
          ]
        },
        "description": "Gộp toàn bộ ảnh viễn thám có cùng coverageKey thành một lớp ImageMosaic trên GeoServer có dimension TIME."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Publish thành công 200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "if (d?.layer?.id) {",
              "    pm.collectionVariables.set('timeSeriesLayerId', String(d.layer.id));",
              "}",
              "if (d?.timeSeries?.defaultTime) {",
              "    pm.collectionVariables.set('timeSeriesSelectedTime', d.timeSeries.defaultTime);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Xem Tile WMS theo thời gian (GetMap Image)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/maps/layers/{{timeSeriesLayerId}}/wms?request=GetMap&version=1.3.0&crs=EPSG:4326&bbox=20.909,107.166,21.226,107.416&width=512&height=512&format=image/png&transparent=true&time={{timeSeriesSelectedTime}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "maps",
            "layers",
            "{{timeSeriesLayerId}}",
            "wms"
          ],
          "query": [
            {
              "key": "request",
              "value": "GetMap"
            },
            {
              "key": "version",
              "value": "1.3.0"
            },
            {
              "key": "crs",
              "value": "EPSG:4326"
            },
            {
              "key": "bbox",
              "value": "20.909,107.166,21.226,107.416"
            },
            {
              "key": "width",
              "value": "512"
            },
            {
              "key": "height",
              "value": "512"
            },
            {
              "key": "format",
              "value": "image/png"
            },
            {
              "key": "transparent",
              "value": "true"
            },
            {
              "key": "time",
              "value": "{{timeSeriesSelectedTime}}"
            }
          ]
        },
        "description": "Lấy tile ảnh PNG từ GeoServer ImageMosaic proxy tại mốc thời gian cụ thể (time ISO UTC)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('WMS trả về 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Định dạng Content-Type là image/png', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
