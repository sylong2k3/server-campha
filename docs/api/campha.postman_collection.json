                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"raster\",\n  \"originalName\": \"sentinel-2-campha.tif\",\n  \"contentType\": \"image/tiff\",\n  \"expireSeconds\": 900\n}",
