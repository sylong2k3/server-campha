        {
          "name": "Presign raster upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created',()=>pm.response.to.have.status(201));",
                  "const d=pm.response.json().data; pm.environment.set('rasterFileObjectId',d.id); pm.environment.set('rasterUploadUrl',d.uploadUrl);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tnmtToken}}",
                "type": "text"
