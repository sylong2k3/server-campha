{
  "info": {
    "_postman_id": "6e53c6b1-68ae-4e60-b780-e3e46caac001",
    "name": "C?m Ph? GIS API - Sprint 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status).to.eql('OK');"
            ]
          }
        }
      ]
    },
    {
      "name": "Login system_admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{testPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login admin 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('adminToken', pm.response.json().data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('admin me 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing token rejected",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 without token', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "system_admin reads logs with DB permission",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/system-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 with DB permission', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
