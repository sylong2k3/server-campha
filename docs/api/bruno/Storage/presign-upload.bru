meta {
  name: Tao presigned URL upload
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/storage/uploads/presign
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "category": "documents",
    "originalName": "baocao.pdf",
    "contentType": "application/pdf",
    "expireSeconds": 900
  }
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "admin@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("adminToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const d = res.getBody().data;
  if (d && d.objectId) bru.setEnvVar("storageObjectId", d.objectId);
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
