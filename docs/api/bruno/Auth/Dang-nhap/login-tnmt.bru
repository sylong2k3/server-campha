meta {
  name: Login - so_tnmt
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "tnmt@campha.gov.vn",
    "password": "CamPha@2026"
  }
}

script:post-response {
  const d = res.getBody().data;
  if (d && d.accessToken) {
    bru.setEnvVar("tnmtToken", d.accessToken);
  }
}

tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
