meta {
  name: Tao nguoi dung moi
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tnmtToken}}
}

body:json {
  {
    "email": "newuser@campha.gov.vn",
    "password": "NewUser@2026",
    "fullName": "Nguyen Van Moi",
    "phone": "0901111222",
    "roleCode": "citizen"
  }
}

script:pre-request {
  const token = bru.getEnvVar("tnmtToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "tnmt@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("tnmtToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const d = res.getBody().data;
  if (d && d.user) bru.setEnvVar("userId", d.user.id);
}

tests {
  test("201 Created", function() { expect(res.getStatus()).to.equal(201); });
}
