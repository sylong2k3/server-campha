meta {
  name: Danh sach nguoi dung
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/users?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tnmtToken}}
}

script:pre-request {
  const token = bru.getEnvVar("tnmtToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "tnmt@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("tnmtToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const items = res.getBody().data.items;
  if (items && items.length > 1) bru.setEnvVar("userId", items[1].id);
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
