meta {
  name: Tao ban do PDF
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/cms/pdf-maps
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "title": "Ban do quy hoach su dung dat 2026",
    "scaleLabel": "1:10.000",
    "mapYear": 2026,
    "preparingAgency": "UBND TP Cam Pha",
    "description": "Ban do quy hoach su dung dat ky 2021-2026",
    "visibility": "public",
    "fileObjectId": "{{storageObjectId}}"
  }
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "admin@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("adminToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const d = res.getBody().data;
  if (d && d.pdfMap) {
    bru.setEnvVar("pdfMapId", d.pdfMap.id);
    bru.setEnvVar("pdfMapUpdatedAt", d.pdfMap.updatedAt);
  }
}

tests {
  test("201 Created", function() { expect(res.getStatus()).to.equal(201); });
}
