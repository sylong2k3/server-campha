meta {
  name: Danh sach ban do PDF (admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/cms/pdf-maps?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "admin@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("adminToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const items = res.getBody().data.items;
  if (items && items.length > 0) {
    bru.setEnvVar("pdfMapId", items[0].id);
    bru.setEnvVar("pdfMapUpdatedAt", items[0].updatedAt);
  }
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
