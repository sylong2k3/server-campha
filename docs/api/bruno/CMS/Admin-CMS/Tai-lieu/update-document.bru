meta {
  name: Cap nhat tai lieu
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/cms/documents/{{documentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "expectedUpdatedAt": "{{documentUpdatedAt}}",
    "title": "Bao cao kinh te xa hoi 2026 (cap nhat)",
    "visibility": "public"
  }
}

script:pre-request {
  const token = bru.getEnvVar("adminToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "admin@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("adminToken", data.data.accessToken);
    }
  }
}

script:post-response {
  const d = res.getBody().data;
  if (d && d.updated_at) bru.setEnvVar("documentUpdatedAt", d.updated_at);
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
