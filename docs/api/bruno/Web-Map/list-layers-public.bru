meta {
  name: Danh sach lop (khong dang nhap)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/web-map/layers
  body: none
  auth: none
}

script:post-response {
  const items = res.getBody().data.items;
  if (items && items.length > 0) bru.setEnvVar("layerId", items[0].id);
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
