meta {
  name: Trang thai Import Job
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/layers/imports/{{jobId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tnmtToken}}
}

script:pre-request {
  const token = bru.getEnvVar("tnmtToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "tnmt@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("tnmtToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const d = res.getBody().data;
  if (d && d.layerId) bru.setEnvVar("layerId", d.layerId);
}

tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
