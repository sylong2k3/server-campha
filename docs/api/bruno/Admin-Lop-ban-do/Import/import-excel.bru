meta {
  name: Import Excel (diem toa do)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/layers/imports/excel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tnmtToken}}
}

body:json {
  {
    "fileObjectId": "{{storageObjectId}}",
    "code": "diem_quan_trac",
    "nameVi": "Diem quan trac moi truong",
    "category": "monitoring",
    "sheetName": "Sheet1",
    "xColumn": "longitude",
    "yColumn": "latitude",
    "sourceSrid": 4326,
    "targetSrid": 4326,
    "isPublic": false
  }
}

script:pre-request {
  const token = bru.getEnvVar("tnmtToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "tnmt@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("tnmtToken", data.data.accessToken);
    }
  }
}
script:post-response {
  const d = res.getBody().data;
  if (d && d.jobId) bru.setEnvVar("jobId", d.jobId);
}

tests {
  test("202 Accepted", function() { expect(res.getStatus()).to.equal(202); });
}
