meta {
  name: Phan quyen lop ban do
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/admin/layers/{{layerId}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tnmtToken}}
}

body:json {
  {
    "permissions": [
      { "roleCode": "so_xd", "canView": true, "canExport": true, "canEdit": false, "canDelete": false },
      { "roleCode": "ubnd_tp", "canView": true, "canExport": false, "canEdit": false, "canDelete": false }
    ]
  }
}

script:pre-request {
  const token = bru.getEnvVar("tnmtToken");
  if (!token) {
    const base = bru.getEnvVar("baseUrl") || "http://localhost:3006";
    const res = await fetch(`${base}/api/v1/auth/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: "tnmt@campha.gov.vn", password: "CamPha@2026" })
    });
    const data = await res.json();
    if (data.data && data.data.accessToken) {
      bru.setEnvVar("tnmtToken", data.data.accessToken);
    }
  }
}
tests {
  test("200 OK", function() { expect(res.getStatus()).to.equal(200); });
}
